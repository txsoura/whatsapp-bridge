# Deployment-level config for the shared Evolution API instance — isolated from any single
# consuming project (this is designed to serve multiple independent projects, not just one).

SERVER_URL=https://whatsapp.yourdomain.com
SERVER_PORT=8080

# Neon Postgres (free tier project, dedicated to this Evolution API deployment only).
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://user:pass@ep-xxxx.neon.tech/evolution_db?sslmode=require
DATABASE_CONNECTION_CLIENT_NAME=evolution_shared

# Lean mode: message bodies are NOT stored here — each consuming project persists its own
# message history in its own database via the per-instance webhook instead. Keeps Neon's
# free 0.5GB storage usable across many instances/projects for much longer.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# Upstash Redis (free tier database, dedicated to this Evolution API deployment only).
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=rediss://default:password@xxx.upstash.io:6379
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Global admin key — keep this only with whoever operates the deployment (you). Consuming
# projects must only ever receive per-instance tokens, never
# this key, so a leak in one project can't expose another project's instances. The gatekeeper
# (proxy/) reads this exact same variable — one shared value, no separate copy to keep in sync.
AUTHENTICATION_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# Webhooks are configured per-instance at creation time (each instance's URL points to
# whichever project owns it) — no global webhook needed.
WEBHOOK_GLOBAL_ENABLED=false

# Gatekeeper (proxy/) settings — shares this same file/Doppler config, one secrets source.
EVOLUTION_API_URL=http://evolution-api:8080
GATEKEEPER_PORT=8081
REGISTRY_PATH=/app/data/registry.json

LOG_LEVEL=ERROR,WARN,INFO
LANGUAGE=pt-BR
